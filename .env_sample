# Covey server configuration
#
# 1. Copy this file to `.env` in the project root: cp .env_sample .env
# 2. Fill in the values below.
# 3. Run `npm start` (or `node --env-file=.env server.js`).
#
# `.env` is already listed in .gitignore, so your real credentials won't be
# committed. Never share your `.env` file or check it into version control.

# Your iCloud email address (the same one you use to sign in to icloud.com).
ICLOUD_EMAIL=[iCloud Email]

# An app-specific password for iCloud - NOT your regular Apple ID password.
# Generate one at https://appleid.apple.com:
#   Sign-In and Security -> App-Specific Passwords -> Generate an App-Specific Password
ICLOUD_APP_PASSWORD=[App Specific Password]

# The exact name of the iCloud calendar to use for shared family events.
# This calendar must already exist - create it in the Calendar app or at
# icloud.com/calendar if it doesn't. Matching is case-insensitive.
CALENDAR_NAME=Family

# Optional: a separate iCloud calendar for reminder-style entries. Adds a
# "Reminder" option to the app. Leave blank or delete this line to disable it.
REMINDERS_CALENDAR=Reminders

# Optional: a separate iCloud calendar for meal/dinner planning. Adds a
# "Dinner" option to the app. Leave blank or delete this line to disable it.
DINNER_CALENDAR=Dinner

# Optional: the local port the server listens on. Defaults to 3000 if unset.
# PORT=3000
